# Copy this file to supabase/.env and fill in a real value.
# supabase/.env is gitignored -- never commit the real token.
#
# Get a token at https://supabase.com/dashboard/account/tokens
# (Personal Access Tokens are account-scoped, not project-scoped --
# treat this with the same care as a password.)
#
# Usage (this repo's CLI commands all target the linked project
# uslcbhozuyyfnencttol, see supabase/.temp/linked-project.json):
#   set -a && source supabase/.env && set +a
#   supabase db push --linked
#   supabase db query --linked "select 1"
#
# If this token ever stops working (401 Unauthorized), it needs to be
# rotated at the URL above and this file updated -- the CLI gives no
# other way to refresh it.

SUPABASE_ACCESS_TOKEN=
